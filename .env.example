PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=braille_library
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24
# Origins of the web UI allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# mongo-express basic auth (docker compose only)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me
